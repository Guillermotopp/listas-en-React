.env.development.local
.env.test.local
.env.production.local

# --- LOGS ---
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- TESTING ---
/coverage
/.nyc_output

